{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "declarationMap": true,
  },
  "include": [
    "src/components",
    "src/hooks",
    "src/contexts",
    "src/store",
    "src/services",
    "src/types",
    "src/config",
    "src/vite-env.d.ts",
  ],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/pages",
    "src/layouts",
    "src/main.tsx",
    "src/App.tsx",
  ],
}
